{
  "Communication": {
    "OverrideRecipientEmail": "testing@beseler.net"
  },
  "Features": {
    "OutboxEnabled": true
  },
  "OAuth": {
    "WebClientId": "beseler-net-web",
    "WebClientSecret": "local-dev-web-client-secret"
  },
  "Jwt": {
    "Issuer": "https://localhost",
    "Audience": "https://localhost",
    "AccessTokenLifetimeMinutes": 5,
    "RefreshTokenLifetimeHours": 1
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "BeselerNet": "Debug"
      }
    }
  }
}
