@host={{$projectUrl}}
@email=testing@beseler.net
@password=password

### Login

# @name login
POST {{host}}/v1/accounts/oauth/tokens
Content-Type: application/json

{
  "grant_type": "password",
  "username": "{{email}}",
  "password": "{{password}}"
}

### App status (anonymous)

GET {{host}}/v1/app

### List settings

GET {{host}}/v1/settings
Authorization: Bearer {{login.response.body.$.access_token}}

### Turn public signup on

PUT {{host}}/v1/settings/public_signup
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "value": "true"
}

### Invite

POST {{host}}/v1/accounts/invite
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "email": "newuser@beseler.net",
  "given_name": "New",
  "family_name": "User",
  "roles": []
}
