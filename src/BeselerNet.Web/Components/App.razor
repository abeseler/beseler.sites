<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e1112" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Beseler" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BeselerNet.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <link rel="manifest" href="@Assets["manifest.webmanifest"]" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <AppRouter @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="_framework/blazor.web.js"></script>
    <script>
        if ("serviceWorker" in navigator) {
            navigator.serviceWorker.register("/service-worker.js");
        }
        window.beselerDownload = {
            json(filename, text) {
                const blob = new Blob([text], { type: "application/json" });
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = filename;
                a.click();
                URL.revokeObjectURL(url);
            }
        };
        window.beselerClock = {
            snapshot() {
                const now = new Date();
                return {
                    timeZone: Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC",
                    year: now.getFullYear(),
                    month: now.getMonth() + 1,
                    day: now.getDate()
                };
            }
        };
        window.beselerIdle = {
            start(net) {
                this.stop();
                this._net = net;
                this._fn = () => this._net.invokeMethodAsync('OnActivity');
                document.addEventListener('pointerdown', this._fn);
                document.addEventListener('keydown', this._fn);
            },
            stop() {
                if (this._fn) {
                    document.removeEventListener('pointerdown', this._fn);
                    document.removeEventListener('keydown', this._fn);
                }
                this._fn = null;
                this._net = null;
            }
        };
    </script>
</body>

</html>
