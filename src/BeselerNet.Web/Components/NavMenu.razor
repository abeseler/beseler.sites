@rendermode InteractiveServer
@inject AuthService Auth
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Beseler .NET</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@Routes.Dashboard">Dashboard</NavLink>
        </div>

        @if (signedIn)
        {
            <div class="nav-user px-3">
                <span class="nav-user-name">@displayName</span>
                <button type="button" class="nav-signout" @onclick="SignOut">Sign out</button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@Routes.Login">Sign in</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@Routes.SignUp">Create account</NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool signedIn;
    private string displayName = "Signed in";

    protected override async Task OnInitializedAsync()
    {
        signedIn = await Auth.HasSession();
        if (signedIn)
            displayName = await Auth.GetSignedInName() ?? "Signed in";
    }

    private async Task SignOut()
    {
        await Auth.SignOut();
        signedIn = false;
        Nav.NavigateTo(Routes.Login, forceLoad: true);
    }
}
