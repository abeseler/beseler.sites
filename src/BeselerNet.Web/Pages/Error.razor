@page "/Error"
@layout BasicLayout
@using System.Diagnostics

<PageTitle>@SiteConstants.SiteName: Error</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <Brand />
        <h1 class="hero-title">Something broke.</h1>
        <p class="auth-lede">The request did not finish.</p>
        @if (ShowRequestId)
        {
            <p class="hero-meta">Request @requestId</p>
        }
        <p class="auth-footer">
            <a href="@Routes.Home">Back home</a>
        </p>
    </div>
</section>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private string? requestId;
    private bool ShowRequestId => !string.IsNullOrEmpty(requestId);

    protected override void OnInitialized()
    {
        requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
