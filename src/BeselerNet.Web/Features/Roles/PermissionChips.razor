@if (Permissions.Count == 0)
{
    <p class="muted-empty">No permissions assigned.</p>
}
else
{
    <div class="perm-groups">
        @foreach (var group in Permissions.GroupBy(permission => permission.Resource).OrderBy(group => group.Key))
        {
            <div>
                <div class="perm-group-title">@group.Key</div>
                <div class="perm-chips">
                    @foreach (var permission in group.OrderBy(permission => permission.Action))
                    {
                        <span class="perm-chip">@permission.Action</span>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<PermissionResponse> Permissions { get; set; } = [];
}
