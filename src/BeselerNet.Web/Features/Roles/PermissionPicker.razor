@if (Catalog.Count == 0)
{
    <p class="muted-empty">No permissions in the catalog.</p>
}
else
{
    <div class="perm-groups">
        @foreach (var group in Catalog.GroupBy(permission => permission.Resource).OrderBy(group => group.Key))
        {
            <div>
                <div class="perm-group-title">@group.Key</div>
                <div class="perm-actions">
                    @foreach (var permission in group.OrderBy(permission => permission.Action))
                    {
                        <label class="auth-check">
                            <input type="checkbox"
                                   checked="@Selected.Contains(permission.PermissionId)"
                                   disabled="@Disabled"
                                   @onchange="e => Toggle(permission.PermissionId, IsChecked(e.Value))" />
                            <span>@permission.Action</span>
                        </label>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<PermissionResponse> Catalog { get; set; } = [];
    [Parameter] public HashSet<int> Selected { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }

    private void Toggle(int permissionId, bool on)
    {
        if (on) Selected.Add(permissionId);
        else Selected.Remove(permissionId);
    }

    private static bool IsChecked(object? value) =>
        value is true || (value is string text && bool.TryParse(text, out var parsed) && parsed);
}
