@inject BudgetService Budget
@inject AccountSession Session

<div class="app-main">
    <p class="kicker">Budget</p>
    <h1 class="page-title">Start @Year</h1>
    <p class="page-lede">Creates all 12 months and stamps templates from today forward. Or import a @Year pack.</p>

    @if (years.Count > 0)
    {
        <div class="budget-year-jump">
            @foreach (var item in years.OrderBy(value => value))
            {
                <a href="@Routes.BudgetYear(item)">@item</a>
            }
        </div>
    }

    @if (error is not null)
    {
        <p class="auth-alert" role="alert">@error</p>
    }

    <section class="role-card">
        <span class="tile-kicker">January start</span>
        <div class="auth-field">
            <label for="start-balance">Starting balance</label>
            <input id="start-balance" inputmode="decimal" @bind="balanceText" disabled="@busy" />
        </div>
        <div class="role-actions">
            <button type="button" class="btn btn-primary" disabled="@(!CanUpdate || busy)" @onclick="Start">
                @(busy ? "Starting…" : $"Start {Year}")
            </button>
        </div>
    </section>

    @if (CanUpdate)
    {
        <section class="role-card">
            <span class="tile-kicker">Import</span>
            <BudgetPackImport Year="Year" Lede="@($"Load a {Year} JSON pack instead of starting empty.")" OnImported="Imported" />
        </section>
    }
</div>

@code {
    [Parameter] public int Year { get; set; }
    [Parameter] public EventCallback<int> OnStarted { get; set; }

    private string balanceText = "0";
    private bool busy;
    private string? error;
    private IReadOnlyList<int> years = [];

    private bool CanUpdate => Session.HasPermission(Resources.Budget, Actions.Update);

    protected override async Task OnInitializedAsync()
    {
        var listed = await Budget.ListYearsAsync();
        if (listed.Succeeded)
            years = listed.Value?.Years ?? [];

        if (years.Contains(Year - 1))
        {
            var previous = await Budget.GetYearAsync(Year - 1);
            var december = previous.Value?.Months.FirstOrDefault(item => item.Month == 12);
            if (december is not null)
                balanceText = december.EndingBalance.ToString("0.##");
        }
    }

    private async Task Start()
    {
        if (!decimal.TryParse(balanceText, out var balance))
        {
            error = "Starting balance must be a number.";
            return;
        }

        busy = true;
        error = null;
        var result = await Budget.StartYearAsync(Year, balance);
        busy = false;
        if (!result.Succeeded)
        {
            error = result.Error ?? "Could not start that year.";
            return;
        }

        await OnStarted.InvokeAsync(Year);
    }

    private Task Imported() => OnStarted.InvokeAsync(Year);
}
