<div class="budget-bar">
    <div class="budget-bar-nav">
        <a class="budget-bar-arrow" href="@PrevHref" aria-label="Previous month">‹</a>
        <span class="budget-bar-title">@Title</span>
        <a class="budget-bar-arrow" href="@NextHref" aria-label="Next month">›</a>
    </div>
    <div class="budget-bar-links">
        <a href="@Routes.BudgetYear(Year)">Summary</a>
        <a href="@Routes.BudgetTemplates">Templates</a>
    </div>
</div>

@code {
    [Parameter] public int Year { get; set; }
    [Parameter] public int Month { get; set; } = 1;
    [Parameter] public string Title { get; set; } = "";

    private string PrevHref => Month <= 1 ? Routes.BudgetMonth(Year - 1, 12) : Routes.BudgetMonth(Year, Month - 1);
    private string NextHref => Month >= 12 ? Routes.BudgetMonth(Year + 1, 1) : Routes.BudgetMonth(Year, Month + 1);
}
