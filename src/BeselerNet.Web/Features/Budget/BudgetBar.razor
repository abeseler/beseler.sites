<div class="budget-bar">
    <div class="budget-bar-nav">
        @if (PrevHref is { } prev)
        {
            <a class="budget-bar-arrow" href="@prev" aria-label="Previous month">‹</a>
        }
        <h1 class="budget-bar-title">@Title</h1>
        @if (NextHref is { } next)
        {
            <a class="budget-bar-arrow" href="@next" aria-label="Next month">›</a>
        }
    </div>
    <div class="budget-bar-links">
        <a href="@Routes.BudgetYear(Year)">Summary</a>
        <a href="@Routes.BudgetYears">Years</a>
        <a href="@Routes.BudgetTemplates">Templates</a>
    </div>
</div>

@code {
    [Parameter] public int Year { get; set; }
    [Parameter] public int Month { get; set; } = 1;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public IReadOnlyList<int> Years { get; set; } = [];

    private string? PrevHref =>
        Month > 1 ? Routes.BudgetMonth(Year, Month - 1)
        : HasYear(Year - 1) ? Routes.BudgetMonth(Year - 1, 12)
        : null;

    private string? NextHref =>
        Month < 12 ? Routes.BudgetMonth(Year, Month + 1)
        : HasYear(Year + 1) ? Routes.BudgetMonth(Year + 1, 1)
        : null;

    private bool HasYear(int year) => Years.Contains(year);
}
