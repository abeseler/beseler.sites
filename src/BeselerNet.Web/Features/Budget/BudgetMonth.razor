@page "/budget/{Year:int}/{Month:int}"
@inject BudgetService Budget
@inject ClientClock Clock
@inject NavigationManager Nav
@inject AccountSession Session
@inject IJSRuntime Js

<PageTitle>@SiteConstants.SiteName: @monthName @Year</PageTitle>

<RequirePermission Resource="@Resources.Budget" Action="@Actions.Read">
@if (loading)
{
    <div class="app-main">
        <p class="kicker">Budget</p>
        <h1 class="page-title">Budget</h1>
        <p class="page-lede">Loading…</p>
    </div>
}
else if (month is null && CanStartThisYear)
{
    <BudgetStart Year="Year" OnStarted="Reload" />
}
else if (month is null)
{
    <div class="app-main">
        <p class="kicker">Budget</p>
        <h1 class="page-title">@monthName @Year</h1>
        <p class="page-lede">That year has not been started.</p>
        <p><a href="@Routes.Budget">This month</a> · <a href="@Routes.BudgetYears">Years</a></p>
    </div>
}
else
{
    <div class="app-main app-main-wide">
        <p class="kicker">Budget</p>
        <BudgetBar Year="Year" Month="Month" Title="@($"{monthName} {Year}")" Years="years" />

        @if (error is not null)
        {
            <p class="auth-alert" role="alert">@error</p>
        }

        <div class="budget-totals">
            <div>
                <span class="tile-kicker">Starting</span>
                <BudgetMoney Value="month.StartingBalance" />
            </div>
            <div>
                <span class="tile-kicker">Cash flow</span>
                <BudgetMoney Value="month.CashFlow" />
            </div>
            <div>
                <span class="tile-kicker">Ending</span>
                <BudgetMoney Value="month.EndingBalance" />
            </div>
        </div>

        <div class="budget-tabs" role="tablist">
            <button type="button" class="budget-tab @(slide == 0 ? "active" : null)" @onclick="() => slide = 0">Income</button>
            <button type="button" class="budget-tab @(slide == 1 ? "active" : null)" @onclick="() => slide = 1">Expenses</button>
            <button type="button" class="budget-tab @(slide == 2 ? "active" : null)" @onclick="() => slide = 2">Savings</button>
        </div>

        <div class="budget-deck"
             style="@($"--slide:{slide}")"
             @onpointerdown="OnPointerDown"
             @onpointerup="OnPointerUp">
            <div class="budget-slides">
                <BudgetSectionList Title="Income" Section="@BudgetSections.Income" Total="month.Income" Lines="Income" NameHints="Hints(BudgetSections.Income)" Year="Year" Month="Month" Today="Today" CanEdit="CanUpdate" OnChanged="ReloadSilent" />
                <BudgetSectionList Title="Expenses" Section="@BudgetSections.Expense" Total="month.Expenses" Lines="Expenses" NameHints="Hints(BudgetSections.Expense)" Year="Year" Month="Month" Today="Today" CanEdit="CanUpdate" OnChanged="ReloadSilent" />
                <BudgetSectionList Title="Savings" Section="@BudgetSections.Savings" Total="month.Savings" Lines="Savings" NameHints="Hints(BudgetSections.Savings)" Year="Year" Month="Month" Today="Today" CanEdit="CanUpdate" OnChanged="ReloadSilent" />
            </div>
        </div>

        <section class="role-card budget-days">
            <button type="button" class="budget-days-toggle" aria-expanded="@daysOpen" @onclick="() => daysOpen = !daysOpen">
                <span class="tile-kicker">Checking by day</span>
                <span class="budget-days-peek">
                    @if (IsCurrentMonth)
                    {
                        <span class="is-now">Now <BudgetMoney Value="CheckingNow" /></span>
                    }
                    @if (LowestDay < 0)
                    {
                        <span>Neg <BudgetMoney Value="LowestDay" /></span>
                    }
                    <span class="budget-days-chevron" aria-hidden="true">@(daysOpen ? "▴" : "▾")</span>
                </span>
            </button>
            @if (month.NextTrough is { } trough)
            {
                <a class="budget-next-trough" href="@Routes.BudgetMonth(trough.Year, trough.Month)">
                    @Abbrev(trough.Month) <BudgetMoney Value="trough.Balance" /> on the @Ordinal(trough.Day)
                </a>
            }
            @if (daysOpen)
            {
                <div class="budget-day-list">
                    @foreach (var day in month.Days)
                    {
                        <div class="budget-day @(IsToday(day.Day) ? "is-now" : null) @(day.Balance < 0 ? "is-neg" : null)" aria-current="@(IsToday(day.Day) ? "date" : null)">
                            <span>@day.Day</span>
                            <BudgetMoney Value="day.Balance" />
                        </div>
                    }
                </div>
            }
        </section>
    </div>
}
</RequirePermission>

@code {
    [Parameter] public int Year { get; set; }
    [Parameter] public int Month { get; set; }

    private BudgetMonthResponse? month;
    private bool loading = true;
    private string? error;
    private int slide;
    private bool daysOpen;
    private double pointerX;
    private double pointerY;
    private bool pointerDown;

    private IReadOnlyList<int> years = [];
    private bool CanUpdate => Session.HasPermission(Resources.Budget, Actions.Update);
    private bool CanStartThisYear =>
        CanUpdate && (Year == Clock.Year || (Clock.Month == 12 && Year == Clock.Year + 1));
    private string monthName => new DateOnly(Year, Month, 1).ToString("MMMM");
    private bool IsCurrentMonth => Clock.Year == Year && Clock.Month == Month;
    private DateOnly Today => Clock.Year > 0
        ? new DateOnly(Clock.Year, Clock.Month, Math.Max(Clock.Day, 1))
        : DateOnly.MinValue;
    private decimal CheckingNow =>
        month?.Days.FirstOrDefault(day => day.Day == Clock.Day)?.Balance ?? 0;
    private decimal LowestDay => month?.Days.Count > 0 ? month.Days.Min(day => day.Balance) : 0;
    private bool IsToday(int day) => IsCurrentMonth && Clock.Day == day;
    private IReadOnlyList<BudgetNameHint> Hints(string section) =>
        month?.SuggestedNames is { } map && map.TryGetValue(section, out var names) ? names : [];

    private IReadOnlyList<BudgetLineResponse> Income => Lines(BudgetSections.Income);
    private IReadOnlyList<BudgetLineResponse> Expenses => Lines(BudgetSections.Expense);
    private IReadOnlyList<BudgetLineResponse> Savings => Lines(BudgetSections.Savings);

    protected override async Task OnParametersSetAsync()
    {
        await Clock.EnsureAsync(Js);
        if (Month is < 1 or > 12)
        {
            Nav.NavigateTo(Routes.Budget, replace: true);
            return;
        }

        await Load();
    }

    private async Task Load()
    {
        loading = true;
        error = null;
        var listed = await Budget.ListYearsAsync();
        if (listed.Succeeded)
            years = listed.Value?.YearNumbers ?? [];
        var result = await Budget.GetMonthAsync(Year, Month);
        loading = false;
        if (result.StatusCode is System.Net.HttpStatusCode.NotFound)
        {
            month = null;
            return;
        }

        if (!result.Succeeded || result.Value is null)
        {
            month = null;
            error = result.Error ?? "Could not load that month.";
            return;
        }

        month = result.Value;
    }

    private async Task Reload() => await Load();

    private async Task ReloadSilent()
    {
        var result = await Budget.GetMonthAsync(Year, Month);
        if (result.Succeeded && result.Value is not null)
            month = result.Value;
        else
            error = result.Error ?? "Could not refresh.";
    }

    private IReadOnlyList<BudgetLineResponse> Lines(string section) =>
        month?.Lines.Where(line => string.Equals(line.Section, section, StringComparison.OrdinalIgnoreCase)).ToArray()
        ?? [];

    private void OnPointerDown(PointerEventArgs e)
    {
        pointerDown = true;
        pointerX = e.ClientX;
        pointerY = e.ClientY;
    }

    private void OnPointerUp(PointerEventArgs e)
    {
        if (!pointerDown)
            return;
        pointerDown = false;
        var dx = e.ClientX - pointerX;
        var dy = e.ClientY - pointerY;
        if (Math.Abs(dx) < 48 || Math.Abs(dx) < Math.Abs(dy))
            return;
        if (dx < 0 && slide < 2)
            slide++;
        else if (dx > 0 && slide > 0)
            slide--;
    }

    private static string Abbrev(int month) => new DateOnly(2000, month, 1).ToString("MMM");

    private static string Ordinal(int day)
    {
        var rem = day % 100;
        if (rem is >= 11 and <= 13)
            return $"{day}th";
        return (day % 10) switch
        {
            1 => $"{day}st",
            2 => $"{day}nd",
            3 => $"{day}rd",
            _ => $"{day}th"
        };
    }

}
