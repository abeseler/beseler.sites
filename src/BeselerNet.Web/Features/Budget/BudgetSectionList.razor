@inject BudgetService Budget

<section class="budget-col role-card">
    <div class="budget-col-head">
        <span class="tile-kicker">@Title</span>
        <BudgetMoney Value="Total" Extra="budget-col-total" />
    </div>

    @if (Lines.Count == 0 && editing is null)
    {
        <p class="muted-empty">Nothing yet.</p>
    }

    @if (Ordered.Any() || editing is not null)
    {
        <div class="budget-line-head">
            <span>Day</span>
            <span>Name</span>
            <span>Amount</span>
        </div>
    }

    <div class="budget-lines">
        @foreach (var line in Ordered)
        {
            @if (editing?.LineId == line.LineId)
            {
                <BudgetLineForm @key="@($"edit-{line.LineId}")" Year="@Year" Month="@Month" Section="@Section" Line="line" NameHints="NameHints" Busy="@(Busy || saving)" OnSaved="Saved" OnCancel="CloseForm" />
            }
            else
            {
                <button type="button" class="budget-line" disabled="@(!CanEdit || Busy)" @onclick="() => BeginEdit(line)">
                    <span class="budget-line-day">@DayLabel(line)</span>
                    <span class="budget-line-name">
                        @line.Name
                        @if (line.TemplateId is not null && !line.Committed)
                        {
                            <span class="budget-est">est</span>
                        }
                    </span>
                    <BudgetMoney Value="@(line.Amount ?? 0)" Extra="budget-line-amt" />
                </button>
            }
        }
    </div>

    @if (adding)
    {
        <BudgetLineForm @key="@("add")" Year="@Year" Month="@Month" Section="@Section" NameHints="NameHints" Busy="@(Busy || saving)" OnSaved="Saved" OnCancel="CloseForm" />
    }
    else if (CanEdit)
    {
        <button type="button" class="btn btn-ghost btn-small" disabled="@Busy" @onclick="BeginAdd">Add</button>
    }
</section>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Section { get; set; } = "";
    [Parameter] public decimal Total { get; set; }
    [Parameter] public IReadOnlyList<BudgetLineResponse> Lines { get; set; } = [];
    [Parameter] public IReadOnlyList<string> NameHints { get; set; } = [];
    [Parameter] public int Year { get; set; }
    [Parameter] public int Month { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private BudgetLineResponse? editing;
    private bool adding;
    private bool saving;

    private void BeginAdd()
    {
        editing = null;
        adding = true;
    }

    private void BeginEdit(BudgetLineResponse line)
    {
        adding = false;
        editing = line;
    }

    private void CloseForm()
    {
        adding = false;
        editing = null;
    }

    private IEnumerable<BudgetLineResponse> Ordered =>
        Lines.OrderBy(line => line.OnDate).ThenBy(line => line.Name, StringComparer.OrdinalIgnoreCase);

    private bool PadDays
    {
        get
        {
            var days = Lines.Select(line => line.OnDate?.Day).OfType<int>().ToArray();
            return days.Any(day => day < 10) && days.Any(day => day >= 10);
        }
    }

    private string DayLabel(BudgetLineResponse line)
    {
        if (line.OnDate is not { } date)
            return "—";
        if (PadDays && date.Day < 10)
            return "\u2007" + date.Day;
        return date.Day.ToString();
    }

    private async Task Saved()
    {
        CloseForm();
        saving = false;
        await OnChanged.InvokeAsync();
    }

}
