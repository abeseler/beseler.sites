@page "/budget"
@inject BudgetService Api
@inject ClientClock Clock
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>@SiteConstants.SiteName: Budget</PageTitle>

<RequirePermission Resource="@Resources.Budget" Action="@Actions.Read">
@if (loading)
{
    <div class="app-main">
        <p class="kicker">Budget</p>
        <p class="page-lede">Loading…</p>
    </div>
}
else if (showStart)
{
    <BudgetStart Year="Clock.Year" OnStarted="GoToMonth" />
}
else
{
    <p class="page-lede">Opening this month…</p>
}
</RequirePermission>

@code {
    private bool loading = true;
    private bool showStart;

    protected override async Task OnInitializedAsync()
    {
        await Clock.EnsureAsync(Js);
        var years = await Api.ListYearsAsync();
        loading = false;
        if (!years.Succeeded)
        {
            showStart = true;
            return;
        }

        var list = years.Value?.Years ?? [];
        if (list.Contains(Clock.Year))
        {
            Nav.NavigateTo(Routes.BudgetMonth(Clock.Year, Clock.Month), replace: true);
            return;
        }

        showStart = true;
    }

    private void GoToMonth(int year) => Nav.NavigateTo(Routes.BudgetMonth(year, Clock.Year == year ? Clock.Month : 1));
}
