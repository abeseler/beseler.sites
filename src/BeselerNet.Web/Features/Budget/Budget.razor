@page "/budget"

<PageTitle>@SiteConstants.SiteName: Budget</PageTitle>

<div class="app-main">
    <p class="kicker">Budget</p>
    <h1 class="page-title">Not built yet.</h1>
    <p class="page-lede">This is the placeholder so the feature has a home. Periods, recurring templates, and the three sections — income, expense, savings — will land here.</p>

    <div class="tile-grid">
        <div class="tile">
            <span class="tile-kicker">Period</span>
            <span class="tile-title">A month you can close</span>
            <span class="tile-copy">Starting balance plus the lines that belong to it.</span>
        </div>
        <div class="tile">
            <span class="tile-kicker">Recurring</span>
            <span class="tile-title">Monthly or every two weeks</span>
            <span class="tile-copy">Templates that stamp into a period so you are not retyping rent.</span>
        </div>
        <div class="tile">
            <span class="tile-kicker">Sections</span>
            <span class="tile-title">Income, expense, savings</span>
            <span class="tile-copy">The three buckets. No more, until we need more.</span>
        </div>
    </div>
</div>
