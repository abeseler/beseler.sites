@attribute [Route(Routes.SignUp)]
@layout BasicLayout
@inject AccountService Accounts
@inject NavigationManager Nav
@inject IHostEnvironment Env

<PageTitle>@SiteConstants.SiteName: Create account</PageTitle>

<RedirectIfSignedIn Return="Return">
<section class="auth-shell">
    <div class="auth-card">
        <Brand />
        <p class="auth-lede">Create an account. You will be signed in after it is created.</p>

        @if (error is not null)
        {
            <p class="auth-alert" role="alert">@error</p>
        }

        <EditForm Model="model" OnValidSubmit="Submit" FormName="signup">
            <DataAnnotationsValidator />

            <div class="auth-field">
                <label for="given">Given name</label>
                <InputText id="given" @bind-Value="model.GivenName" autocomplete="given-name" />
                <ValidationMessage For="() => model.GivenName" />
                <FieldError Keys="@fieldErrors" Name="given_name" />
            </div>
            <div class="auth-field">
                <label for="family">Family name</label>
                <InputText id="family" @bind-Value="model.FamilyName" autocomplete="family-name" />
                <ValidationMessage For="() => model.FamilyName" />
                <FieldError Keys="@fieldErrors" Name="family_name" />
            </div>
            <div class="auth-field">
                <label for="email">Email</label>
                <InputText id="email" @bind-Value="model.Email" autocomplete="username" />
                <ValidationMessage For="() => model.Email" />
                <FieldError Keys="@fieldErrors" Name="email" />
            </div>
            <div class="auth-field">
                <label for="password">Password</label>
                <InputText id="password" type="password" @bind-Value="model.Password" autocomplete="new-password" />
                <ValidationMessage For="() => model.Password" />
                <FieldError Keys="@fieldErrors" Name="password" />
            </div>
            <label class="auth-check">
                <InputCheckbox id="persist" @bind-Value="model.ThisDevice" />
                <span>
                    This is my device
                    <span class="auth-check-hint">Stay signed in after you close the browser. Skip this on a shared computer.</span>
                </span>
            </label>

            <button type="submit" class="auth-submit" disabled="@busy">
                @(busy ? "Creating…" : "Create account")
            </button>
        </EditForm>

        <p class="auth-footer">
            Already have an account? <a href="@ReturnUrl.WithReturn(Routes.Login, Return)">Sign in</a>
        </p>
    </div>
</section>
</RedirectIfSignedIn>

@code {
    [SupplyParameterFromQuery(Name = ReturnUrl.Query)]
    public string? Return { get; set; }

    private readonly SignUpModel model = new();
    private bool busy;
    private string? error;
    private IDictionary<string, string[]>? fieldErrors;

    protected override void OnInitialized()
    {
        if (Env.IsDevelopment())
            model.Email = SiteConstants.DevelopmentEmail;
    }

    private async Task Submit()
    {
        busy = true;
        error = null;
        fieldErrors = null;

        var result = await Accounts.RegisterAsync(new()
        {
            Email = model.Email,
            Password = model.Password,
            GivenName = model.GivenName,
            FamilyName = model.FamilyName
        }, model.ThisDevice, Return);

        busy = false;

        if (result.Succeeded)
        {
            Nav.NavigateTo(result.Value!, forceLoad: true);
            return;
        }

        error = result.Error;
        fieldErrors = result.FieldErrors;
    }

    private sealed class SignUpModel
    {
        [Required]
        public string GivenName { get; set; } = "";

        [Required]
        public string FamilyName { get; set; } = "";

        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required, MinLength(AuthLimits.PasswordMinLength)]
        public string Password { get; set; } = "";

        public bool ThisDevice { get; set; }
    }
}
