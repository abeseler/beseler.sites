@attribute [Route(Routes.ResetPassword)]
@layout BasicLayout
@inject AccountService Accounts

<PageTitle>@SiteConstants.SiteName: Reset password</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <Brand />

        @if (string.IsNullOrWhiteSpace(Token))
        {
            <p class="auth-alert" role="alert">This page needs the link from your email.</p>
            <p class="auth-footer">
                <a href="@Routes.ForgotPassword">Request a new link</a>
            </p>
        }
        else if (done)
        {
            <p class="auth-lede">Your password is updated. Sign in with the new one.</p>
            <p class="auth-footer">
                <a href="@Routes.Login">Sign in</a>
            </p>
        }
        else
        {
            <p class="auth-lede">Choose a new password.</p>

            @if (error is not null)
            {
                <p class="auth-alert" role="alert">@error</p>
            }

            <EditForm Model="model" OnValidSubmit="Submit" FormName="reset">
                <DataAnnotationsValidator />
                <div class="auth-field">
                    <label for="password">New password</label>
                    <InputText id="password" type="password" @bind-Value="model.Password" autocomplete="new-password" />
                    <ValidationMessage For="() => model.Password" />
                </div>
                <div class="auth-field">
                    <label for="confirm">Confirm password</label>
                    <InputText id="confirm" type="password" @bind-Value="model.Confirm" autocomplete="new-password" />
                    <ValidationMessage For="() => model.Confirm" />
                </div>
                <button type="submit" class="auth-submit" disabled="@busy">
                    @(busy ? "Saving…" : "Update password")
                </button>
            </EditForm>

            <p class="auth-footer">
                <a href="@Routes.ForgotPassword">Request a new link</a>
            </p>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private readonly ResetModel model = new();
    private bool busy;
    private bool done;
    private string? error;

    private async Task Submit()
    {
        if (model.Password != model.Confirm)
        {
            error = "The two passwords do not match.";
            return;
        }

        busy = true;
        error = null;
        var result = await Accounts.ResetPasswordAsync(Token!, model.Password);
        busy = false;

        if (result.Succeeded)
        {
            done = true;
            return;
        }

        error = result.Error;
    }

    private sealed class ResetModel
    {
        [Required, MinLength(8)]
        public string Password { get; set; } = "";

        [Required]
        public string Confirm { get; set; } = "";
    }
}
