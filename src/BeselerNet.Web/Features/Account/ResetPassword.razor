@attribute [Route(Routes.ResetPassword)]
@layout BasicLayout
@inject AccountService Accounts
@inject NavigationManager Nav

<PageTitle>@SiteConstants.SiteName: Reset password</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <Brand />

        @if (string.IsNullOrWhiteSpace(Token))
        {
            <p class="auth-alert" role="alert">This page needs the link from your email.</p>
            <p class="auth-footer">
                <a href="@ReturnUrl.WithReturn(Routes.ForgotPassword, Return)">Request a new link</a>
            </p>
        }
        else
        {
            <p class="auth-lede">Choose a new password. You will be signed in after it is saved.</p>

            @if (error is not null)
            {
                <p class="auth-alert" role="alert">@error</p>
            }

            <EditForm Model="model" OnValidSubmit="Submit" FormName="reset">
                <DataAnnotationsValidator />
                <div class="auth-field">
                    <label for="password">New password</label>
                    <InputText id="password" type="password" @bind-Value="model.Password" autocomplete="new-password" />
                    <ValidationMessage For="() => model.Password" />
                </div>
                <div class="auth-field">
                    <label for="confirm">Confirm password</label>
                    <InputText id="confirm" type="password" @bind-Value="model.Confirm" autocomplete="new-password" />
                    <ValidationMessage For="() => model.Confirm" />
                </div>
                <label class="auth-check">
                    <InputCheckbox id="persist" @bind-Value="model.ThisDevice" />
                    <span>
                        This is my device
                        <span class="auth-check-hint">Stay signed in after you close the browser. Skip this on a shared computer.</span>
                    </span>
                </label>
                <button type="submit" class="auth-submit" disabled="@busy">
                    @(busy ? "Saving…" : "Update password")
                </button>
            </EditForm>

            <p class="auth-footer">
                <a href="@ReturnUrl.WithReturn(Routes.ForgotPassword, Return)">Request a new link</a>
            </p>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = ReturnUrl.Query)]
    public string? Return { get; set; }

    private readonly ResetModel model = new();
    private bool busy;
    private string? error;

    private async Task Submit()
    {
        if (model.Password != model.Confirm)
        {
            error = "The two passwords do not match.";
            return;
        }

        busy = true;
        error = null;
        var result = await Accounts.ResetPasswordAsync(Token!, model.Password, model.ThisDevice, Return);
        busy = false;

        if (result.Succeeded)
        {
            Nav.NavigateTo(result.Value!, forceLoad: true);
            return;
        }

        error = result.Error;
    }

    private sealed class ResetModel
    {
        [Required, MinLength(AuthLimits.PasswordMinLength)]
        public string Password { get; set; } = "";

        [Required]
        public string Confirm { get; set; } = "";

        public bool ThisDevice { get; set; }
    }
}
