@attribute [Route(Routes.ForgotPassword)]
@layout BasicLayout
@inject AccountService Accounts
@inject IHostEnvironment Env

<PageTitle>@SiteConstants.SiteName: Forgot password</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <Brand />
        <p class="auth-lede">Enter your email. If an account exists, we will send a reset link (about 20 minutes).</p>

        @if (error is not null)
        {
            <p class="auth-alert" role="alert">@error</p>
        }
        else if (sent)
        {
            <p class="auth-lede">If that address is on file, a message is on the way.</p>
        }

        <EditForm Model="model" OnValidSubmit="Submit" FormName="forgot">
            <DataAnnotationsValidator />
            <div class="auth-field">
                <label for="email">Email</label>
                <InputText id="email" @bind-Value="model.Email" autocomplete="username" />
                <ValidationMessage For="() => model.Email" />
            </div>
            <button type="submit" class="auth-submit" disabled="@busy">
                @(busy ? "Sending…" : "Send reset link")
            </button>
        </EditForm>

        <p class="auth-footer">
            <a href="@ReturnUrl.WithReturn(Routes.Login, Return)">Back to sign in</a>
        </p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = ReturnUrl.Query)]
    public string? Return { get; set; }

    private readonly EmailModel model = new();
    private bool busy;
    private bool sent;
    private string? error;

    protected override void OnInitialized()
    {
        if (Env.IsDevelopment())
            model.Email = SiteConstants.DevelopmentEmail;
    }

    private async Task Submit()
    {
        busy = true;
        error = null;
        sent = false;
        var result = await Accounts.RequestPasswordResetAsync(model.Email);
        busy = false;

        if (result.Succeeded)
        {
            sent = true;
            return;
        }

        error = result.Error;
    }

    private sealed class EmailModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";
    }
}
