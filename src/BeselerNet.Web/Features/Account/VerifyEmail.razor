@attribute [Route(Routes.VerifyEmail)]
@layout BasicLayout
@inject AccountService Accounts
@inject AccountSession Session

<PageTitle>@SiteConstants.SiteName: Verify email</PageTitle>

<RequireSession RequireVerified="false" RedirectIfVerified="true">
    <section class="auth-shell">
        <div class="auth-card">
            <Brand />
            <p class="auth-lede">
                We sent a confirmation link to <strong>@address</strong>.
                Open it to finish. The link expires in @AuthLimits.ConfirmEmailExpiryText.
            </p>

            @if (error is not null)
            {
                <p class="auth-alert" role="alert">@error</p>
            }
            else if (sent)
            {
                <p class="auth-lede">A new message is on the way to @address.</p>
            }

            <button type="button" class="auth-submit" disabled="@busy" @onclick="Resend">
                @(busy ? "Sending…" : "Resend confirmation email")
            </button>

            <p class="auth-footer">
                <a href="@Routes.SignOut">Sign out</a>
            </p>
        </div>
    </section>
</RequireSession>

@code {
    [SupplyParameterFromQuery(Name = ReturnUrl.Query)]
    public string? Return { get; set; }

    private bool busy;
    private bool sent;
    private string? error;
    private string address = "your email";

    protected override void OnInitialized()
    {
        address = Session.Profile?.Email ?? "your email";
    }

    private async Task Resend()
    {
        busy = true;
        error = null;
        sent = false;
        var result = await Accounts.ResendVerificationAsync();
        busy = false;

        if (result.Succeeded)
        {
            sent = true;
            return;
        }

        error = result.Error;
    }
}
