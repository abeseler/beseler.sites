@attribute [Route(Routes.ConfirmEmail)]
@layout BasicLayout
@inject AccountService Accounts
@inject NavigationManager Nav

<PageTitle>@SiteConstants.SiteName: Confirm email</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <Brand />

        @if (state == PageState.Working)
        {
            <p class="auth-lede">Confirming your email…</p>
        }
        else
        {
            @if (error is not null)
            {
                <p class="auth-alert" role="alert">@error</p>
            }
            <p class="auth-footer">
                Need a new link? <a href="@Routes.VerifyEmail">Resend confirmation</a>
                · <a href="@Routes.Login">Sign in</a>
            </p>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = ReturnUrl.Query)]
    public string? Return { get; set; }

    private PageState state = PageState.Working;
    private string? error;
    private bool started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || started)
            return;

        started = true;

        if (string.IsNullOrWhiteSpace(Token))
        {
            state = PageState.Failed;
            error = "This page needs the link from your email.";
            StateHasChanged();
            return;
        }

        var result = await Accounts.ConfirmEmailAsync(Token, Return);
        if (result.Succeeded)
        {
            Nav.NavigateTo(result.Value!, forceLoad: true);
            return;
        }

        state = PageState.Failed;
        error = result.Error;
        StateHasChanged();
    }

    private enum PageState { Working, Failed }
}
