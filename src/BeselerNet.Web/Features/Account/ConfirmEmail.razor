@attribute [Route(Routes.ConfirmEmail)]
@layout BasicLayout
@inject AccountService Accounts
@inject NavigationManager Nav

<PageTitle>@SiteConstants.SiteName: Confirm email</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <Brand />
        <h1 class="visually-hidden">Confirm email</h1>

        @if (state == PageState.Working)
        {
            <p class="auth-lede">Confirming your email…</p>
        }
        else
        {
            @if (error is not null)
            {
                <p class="auth-alert" role="alert">@error</p>
            }
            <p class="auth-lede">If the link expired, enter your email. We will send a new one if that address still needs confirming.</p>
            <div class="auth-field">
                <label for="confirm-email">Email</label>
                <input id="confirm-email" type="email" @bind="email" disabled="@busy" />
            </div>
            <button type="button" class="auth-submit" disabled="@busy" @onclick="RequestLink">
                @(busy ? "Sending…" : "Send a new link")
            </button>
            @if (sent)
            {
                <NoticeOk OnDismiss="() => sent = false">If that address still needs confirming, a new link is on the way.</NoticeOk>
            }
            <p class="auth-footer">
                <a href="@Routes.Login">Sign in</a>
            </p>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = ReturnUrl.Query)]
    public string? Return { get; set; }

    private PageState state = PageState.Working;
    private string? error;
    private bool started;
    private bool busy;
    private bool sent;
    private string email = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || started)
            return;

        started = true;

        if (string.IsNullOrWhiteSpace(Token))
        {
            state = PageState.Failed;
            error = "This page needs the link from your email.";
            StateHasChanged();
            return;
        }

        var result = await Accounts.ConfirmEmailAsync(Token, Return);
        if (result.Succeeded)
        {
            Nav.NavigateTo(result.Value!, forceLoad: true);
            return;
        }

        state = PageState.Failed;
        error = result.Error ?? "This link is invalid or has expired.";
        StateHasChanged();
    }

    private async Task RequestLink()
    {
        busy = true;
        sent = false;
        error = null;
        var result = await Accounts.RequestEmailConfirmationAsync(email);
        busy = false;
        if (!result.Succeeded)
        {
            error = result.Error ?? "Could not send a new link.";
            return;
        }

        sent = true;
    }

    private enum PageState { Working, Failed }
}
