@attribute [Route(Routes.Login)]
@layout BasicLayout
@inject AccountService Accounts
@inject NavigationManager Nav
@inject IHostEnvironment Env

<PageTitle>@SiteConstants.SiteName: Sign in</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <Brand />
        <p class="auth-lede">Sign in with the email you registered.</p>

        @if (error is not null)
        {
            <p class="auth-alert" role="alert">@error</p>
        }

        <EditForm Model="model" OnValidSubmit="Submit" FormName="login">
            <DataAnnotationsValidator />

            <div class="auth-field">
                <label for="email">Email</label>
                <InputText id="email" @bind-Value="model.Email" autocomplete="username" />
                <ValidationMessage For="() => model.Email" />
            </div>
            <div class="auth-field">
                <label for="password">Password</label>
                <InputText id="password" type="password" @bind-Value="model.Password" autocomplete="current-password" />
                <ValidationMessage For="() => model.Password" />
            </div>
            <label class="auth-check">
                <InputCheckbox id="persist" @bind-Value="model.ThisDevice" />
                <span>
                    This is my device
                    <span class="auth-check-hint">Stay signed in after you close the browser. Skip this on a shared computer.</span>
                </span>
            </label>

            <button type="submit" class="auth-submit" disabled="@busy">
                @(busy ? "Signing in…" : "Sign in")
            </button>
        </EditForm>

        <p class="auth-footer">
            <a href="@ReturnUrl.WithReturn(Routes.ForgotPassword, Return)">Forgot password?</a>
            · No account? <a href="@ReturnUrl.WithReturn(Routes.SignUp, Return)">Create one</a>
        </p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = ReturnUrl.Query)]
    public string? Return { get; set; }

    private readonly LoginModel model = new();
    private bool busy;
    private string? error;

    protected override void OnInitialized()
    {
        if (Env.IsDevelopment())
            model.Email = SiteConstants.DevelopmentEmail;
    }

    private async Task Submit()
    {
        busy = true;
        error = null;
        var result = await Accounts.LoginAsync(model.Email, model.Password, model.ThisDevice, Return);
        busy = false;

        if (result.Succeeded)
        {
            Nav.NavigateTo(result.Value!, forceLoad: true);
            return;
        }

        error = result.Error;
    }

    private sealed class LoginModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";

        public bool ThisDevice { get; set; }
    }
}
