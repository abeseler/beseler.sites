@attribute [Route(Routes.AccountDetailTemplate)]
@inject AccountsService AccountsApi
@inject RoleService RolesApi
@inject AccountSession Session
@inject NavigationManager Nav

<PageTitle>@SiteConstants.SiteName: User</PageTitle>

<RequirePermission Resource="@Resources.Account" Action="@Actions.Read" Scope="@Scopes.Global">
<div class="app-main">
    <p class="kicker"><a href="@Routes.Accounts">Users</a></p>
    <h1 class="page-title">@(account?.Name ?? "User")</h1>
    <p class="page-lede">@lede</p>

    @if (error is not null)
    {
        <p class="auth-alert" role="alert">@error</p>
    }
    @if (notice is not null)
    {
        <NoticeOk OnDismiss="() => notice = null">@notice</NoticeOk>
    }

    @if (loading)
    {
        <p class="page-lede">Loading…</p>
    }
    else if (account is not null)
    {
        <div class="role-list">
        <section class="role-card">
            <div class="role-card-head">
                <span class="role-name">@account.Name</span>
                <AccountStatusBadges Account="account" IsSelf="isSelf" />
            </div>
            <p class="muted-empty">@account.Email</p>
            <p class="muted-empty">@rolesLabel</p>
            <p class="muted-empty">Created @When(account.CreatedAt) · Last sign-in @When(account.LastLogon)</p>

            @if (CanUpdate)
            {
                <div class="auth-field">
                    <label for="given">Given name</label>
                    <input id="given" @bind="givenName" maxlength="64" disabled="@busy" />
                </div>
                <div class="auth-field">
                    <label for="family">Family name</label>
                    <input id="family" @bind="familyName" maxlength="64" disabled="@busy" />
                </div>
                <div class="role-actions">
                    <button type="button" class="btn btn-primary btn-small" disabled="@busy" @onclick="Save">
                        @(busy ? "Saving…" : "Save name")
                    </button>
                </div>
            }

            @if (CanAdminister && !isSelf)
            {
                <div class="role-actions">
                    @if (account.Disabled)
                    {
                        <button type="button" class="btn btn-ghost btn-small" disabled="@busy" @onclick="Enable">Enable</button>
                    }
                    else if (confirmDisable)
                    {
                        <button type="button" class="btn btn-danger btn-small" disabled="@busy" @onclick="Disable">Confirm disable</button>
                        <button type="button" class="btn btn-ghost btn-small" disabled="@busy" @onclick="() => confirmDisable = false">Keep</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-danger btn-small" disabled="@busy" @onclick="() => confirmDisable = true">Disable</button>
                    }

                    @if (account.Locked)
                    {
                        <button type="button" class="btn btn-ghost btn-small" disabled="@busy" @onclick="Unlock">Unlock</button>
                    }

                    @if (account.Invited)
                    {
                        <button type="button" class="btn btn-ghost btn-small" disabled="@busy" @onclick="ResendInvite">
                            @(busy ? "Sending…" : "Resend invite")
                        </button>
                    }
                </div>
            }
            else if ((CanAdminister || CanDelete) && isSelf)
            {
                <p class="muted-empty">You cannot disable, unlock, change roles, or delete your own account.</p>
            }
        </section>

        @if (CanAdminister)
        {
            <section class="role-card">
                <span class="tile-kicker">Roles</span>
                @if (isSelf)
                {
                    <p class="muted-empty">@rolesLabel</p>
                }
                else if (edits.Count == 0)
                {
                    <p class="muted-empty">No roles in the catalog.</p>
                }
                else
                {
                    <div class="perm-groups">
                        @foreach (var edit in edits)
                        {
                            <div class="role-assign">
                                <label class="auth-check">
                                    <input type="checkbox"
                                           checked="@edit.Selected"
                                           disabled="@busy"
                                           @onchange="e => Toggle(edit, IsChecked(e.Value))" />
                                    <span>@edit.Name</span>
                                </label>
                                @if (edit.Selected)
                                {
                                    <select class="auth-select" @bind="edit.Scope" disabled="@busy">
                                        <option value="@Scopes.Owned">Their own</option>
                                        <option value="@Scopes.Global">Everything</option>
                                        @if (edit.Scope == Scopes.Shared)
                                        {
                                            <option value="@Scopes.Shared">Shared</option>
                                        }
                                        else if (edit.Scope == Scopes.Self)
                                        {
                                            <option value="@Scopes.Self">Self</option>
                                        }
                                    </select>
                                }
                            </div>
                        }
                    </div>
                    <div class="role-actions">
                        <button type="button" class="btn btn-primary btn-small" disabled="@busy" @onclick="SaveRoles">
                            @(busy ? "Saving…" : "Save roles")
                        </button>
                    </div>
                }
            </section>
        }

        @if (CanDelete && !isSelf)
        {
            <section class="role-card">
                <span class="tile-kicker">Delete</span>
                <p class="page-lede">Removes this account, their budget, and their sessions. No undo.</p>
                @if (confirmDelete)
                {
                    <div class="auth-field">
                        <label for="confirm-delete">Type @deleteConfirmTarget to confirm</label>
                        <input id="confirm-delete" @bind="confirmDeleteText" disabled="@busy" />
                    </div>
                    <div class="role-actions">
                        <button type="button" class="btn btn-danger btn-small" disabled="@busy" @onclick="Delete">Delete account</button>
                        <button type="button" class="btn btn-ghost btn-small" disabled="@busy" @onclick="CancelDelete">Keep</button>
                    </div>
                }
                else
                {
                    <div class="role-actions">
                        <button type="button" class="btn btn-danger btn-small" disabled="@busy" @onclick="() => confirmDelete = true">Delete</button>
                    </div>
                }
            </section>
        }

        @if (catalog.Count > 0)
        {
            <section class="role-card">
                <span class="tile-kicker">Access</span>
                @if (access.Count == 0)
                {
                    <p class="muted-empty">No permissions from their roles.</p>
                }
                else
                {
                    <div class="access-list">
                        @foreach (var group in access)
                        {
                            <div class="access-group">
                                <div class="perm-group-title">@group.Resource</div>
                                @if (group.SharedGrant)
                                {
                                    <div class="access-actions">
                                        @foreach (var row in group.Rows)
                                        {
                                            <span class="perm-chip">@row.Action</span>
                                        }
                                    </div>
                                    <span class="access-from">@group.Rows[0].GrantedBy</span>
                                }
                                else
                                {
                                    @foreach (var row in group.Rows)
                                    {
                                        <div class="access-row">
                                            <span class="perm-chip">@row.Action</span>
                                            <span class="access-from">@row.GrantedBy</span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        }
        </div>
    }
</div>
</RequirePermission>

@code {
    [Parameter] public int Id { get; set; }

    private int loadedId;
    private AccountResponse? account;
    private IReadOnlyList<RoleResponse> catalog = [];
    private IReadOnlyList<AccessGroup> access = [];
    private List<RoleEdit> edits = [];
    private string givenName = "";
    private string familyName = "";
    private bool loading = true;
    private bool busy;
    private bool confirmDisable;
    private bool confirmDelete;
    private string confirmDeleteText = "";
    private string? error;
    private string? notice;

    private bool isSelf => account is not null && account.AccountId == Session.Profile?.AccountId;
    private bool CanUpdate => Session.HasPermission(Resources.Account, Actions.Update);
    private bool CanAdminister => Session.HasPermission(Resources.Account, Actions.Update, Scopes.Global);
    private bool CanDelete => Session.HasPermission(Resources.Account, Actions.Delete, Scopes.Global);
    private string deleteConfirmTarget => account?.Email ?? account?.Username ?? "";
    private string lede => account is null ? "User details." : "Profile, status, and roles.";
    private string rolesLabel =>
        account?.Roles is { Count: > 0 } roles
            ? string.Join(" · ", roles.Select(role => $"{role.Name} ({role.Scope})"))
            : "No roles";

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == Id && account is not null)
            return;

        loadedId = Id;
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        error = null;
        notice = null;
        confirmDisable = false;
        confirmDelete = false;
        confirmDeleteText = "";
        var result = await AccountsApi.GetAsync(Id);
        if (!result.Succeeded || result.Value is null)
        {
            account = null;
            edits = [];
            error = result.Error ?? "Could not load that account.";
            loading = false;
            return;
        }

        Apply(result.Value);

        if (Session.HasPermission(Resources.Role, Actions.Read))
        {
            var listed = await RolesApi.ListAsync();
            if (listed.Succeeded)
                catalog = listed.Value ?? [];
            else
                error = listed.Error ?? "Could not load roles.";
        }

        BindEdits();
        BindAccess();
        loading = false;
    }

    private void Apply(AccountResponse value)
    {
        account = value;
        givenName = value.GivenName ?? "";
        familyName = value.FamilyName ?? "";
        BindEdits();
        BindAccess();
    }

    private void BindAccess()
    {
        if (account is null || catalog.Count == 0)
        {
            access = [];
            return;
        }

        var byId = catalog.ToDictionary(role => role.RoleId);
        var granted = new Dictionary<(string Resource, string Action), List<string>>();
        foreach (var assigned in account.Roles)
        {
            if (!byId.TryGetValue(assigned.RoleId, out var role))
                continue;

            var from = $"{assigned.Name} ({assigned.Scope})";
            foreach (var permission in role.Permissions)
            {
                var key = (permission.Resource, permission.Action);
                if (!granted.TryGetValue(key, out var roles))
                {
                    roles = [];
                    granted[key] = roles;
                }

                if (!roles.Contains(from, StringComparer.Ordinal))
                    roles.Add(from);
            }
        }

        access = granted
            .GroupBy(row => row.Key.Resource, StringComparer.Ordinal)
            .OrderBy(group => group.Key, StringComparer.Ordinal)
            .Select(group => new AccessGroup(
                group.Key,
                group
                    .OrderBy(row => row.Key.Action, StringComparer.Ordinal)
                    .Select(row => new AccessRow(row.Key.Action, string.Join(" · ", row.Value)))
                    .ToArray()))
            .ToArray();
    }

    private void BindEdits()
    {
        if (account is null || catalog.Count == 0)
        {
            edits = [];
            return;
        }

        var current = account.Roles.ToDictionary(role => role.RoleId, role => role.Scope);
        edits = catalog.Select(role => new RoleEdit
        {
            RoleId = role.RoleId,
            Name = role.Name,
            Selected = current.ContainsKey(role.RoleId),
            Scope = current.TryGetValue(role.RoleId, out var scope) ? scope : DefaultScope(role.Name)
        }).ToList();
    }

    private static void Toggle(RoleEdit edit, bool on)
    {
        edit.Selected = on;
        if (on && string.IsNullOrWhiteSpace(edit.Scope))
            edit.Scope = DefaultScope(edit.Name);
    }

    private static string DefaultScope(string name) =>
        string.Equals(name, BeselerNet.Shared.Roles.Admin, StringComparison.OrdinalIgnoreCase) ? Scopes.Global : Scopes.Owned;

    private static bool IsChecked(object? value) =>
        value is true || (value is string text && bool.TryParse(text, out var parsed) && parsed);

    private async Task Save()
    {
        if (account is null)
            return;

        busy = true;
        error = null;
        notice = null;
        var result = await AccountsApi.UpdateAsync(account.AccountId, givenName, familyName);
        busy = false;
        if (!result.Succeeded || result.Value is null)
        {
            error = result.Error ?? "Could not save.";
            return;
        }

        Apply(result.Value);
        notice = "Name saved.";
        if (isSelf)
            await Session.RefreshProfileAsync();
    }

    private async Task SaveRoles()
    {
        if (account is null)
            return;

        busy = true;
        error = null;
        notice = null;
        var roles = edits
            .Where(edit => edit.Selected)
            .Select(edit => new AccountRoleAssignment { RoleId = edit.RoleId, Scope = edit.Scope })
            .ToArray();
        var result = await AccountsApi.SetRolesAsync(account.AccountId, roles);
        busy = false;
        if (!result.Succeeded || result.Value is null)
        {
            error = result.Error ?? "Could not save roles.";
            return;
        }

        Apply(result.Value);
        notice = "Roles saved.";
    }

    private async Task ResendInvite()
    {
        if (account is null)
            return;

        busy = true;
        error = null;
        notice = null;
        var result = await AccountsApi.ResendInviteAsync(account.AccountId);
        busy = false;
        if (!result.Succeeded)
        {
            error = result.Error ?? "Could not resend the invite.";
            return;
        }

        notice = "Invite sent.";
    }

    private Task Disable() => RunAdmin(AccountsApi.DisableAsync, "Account disabled.");
    private Task Enable() => RunAdmin(AccountsApi.EnableAsync, "Account enabled.");
    private Task Unlock() => RunAdmin(AccountsApi.UnlockAsync, "Lockout cleared.");

    private void CancelDelete()
    {
        confirmDelete = false;
        confirmDeleteText = "";
    }

    private async Task Delete()
    {
        if (account is null)
            return;

        if (!string.Equals(confirmDeleteText.Trim(), deleteConfirmTarget, StringComparison.OrdinalIgnoreCase))
        {
            error = $"Type {deleteConfirmTarget} to delete this account.";
            return;
        }

        busy = true;
        error = null;
        notice = null;
        var result = await AccountsApi.DeleteAsync(account.AccountId);
        busy = false;
        if (!result.Succeeded)
        {
            error = result.Error ?? "Could not delete that account.";
            return;
        }

        Nav.NavigateTo(Routes.Accounts);
    }

    private async Task RunAdmin(Func<int, CancellationToken, Task<ApiResult<AccountResponse>>> action, string done)
    {
        if (account is null)
            return;

        busy = true;
        error = null;
        notice = null;
        confirmDisable = false;
        var result = await action(account.AccountId, default);
        busy = false;
        if (!result.Succeeded || result.Value is null)
        {
            error = result.Error ?? "Could not update that account.";
            return;
        }

        Apply(result.Value);
        notice = done;
    }

    private static string When(DateTimeOffset? value) =>
        value is { } time ? time.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "never";

    private sealed record AccessGroup(string Resource, IReadOnlyList<AccessRow> Rows)
    {
        public bool SharedGrant =>
            Rows.Count > 0 && Rows.All(row => string.Equals(row.GrantedBy, Rows[0].GrantedBy, StringComparison.Ordinal));
    }

    private sealed record AccessRow(string Action, string GrantedBy);

    private sealed class RoleEdit
    {
        public int RoleId { get; init; }
        public string Name { get; init; } = "";
        public bool Selected { get; set; }
        public string Scope { get; set; } = Scopes.Owned;
    }
}
