@inject AccountSession Session
@inject NavigationManager Nav

<div class="nav-brand">
    <a href="@Routes.Dashboard">
        <span class="auth-brand-mark">beseler</span>
        <span class="nav-brand-name">Beseler <span>.NET</span></span>
    </a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav-list">
        <div class="nav-group">
            <p class="nav-group-label">Apps</p>
            <NavLink class="nav-link" href="@Routes.Budget">Budget</NavLink>
        </div>

        <div class="nav-group">
            <p class="nav-group-label">You</p>
            <NavLink class="nav-link" href="@Routes.Account" Match="NavLinkMatch.All">Account</NavLink>
        </div>

        @if (Session.SeesAdminNav)
        {
            <div class="nav-group">
                <p class="nav-group-label">Admin</p>
                <Can Resource="@Resources.Account" Action="@Actions.Read" Scope="@Scopes.Global">
                    <NavLink class="nav-link" href="@Routes.Accounts">Users</NavLink>
                </Can>
                <Can Resource="@Resources.Role" Action="@Actions.Read">
                    <NavLink class="nav-link" href="@Routes.Roles">Roles</NavLink>
                </Can>
                <Can Resource="@Resources.Setting" Action="@Actions.Read">
                    <NavLink class="nav-link" href="@Routes.Settings">Settings</NavLink>
                </Can>
            </div>
        }
    </nav>

    <div class="nav-user">
        <span class="nav-user-name">@displayName</span>
        <button type="button" class="nav-signout" @onclick="SignOut">Sign out</button>
    </div>
</div>

@code {
    private string displayName = "Signed in";

    protected override void OnInitialized()
    {
        displayName = Session.Name ?? Session.Profile?.Email ?? "Signed in";
    }

    private void SignOut() => Nav.NavigateTo(Routes.SignOut, forceLoad: true);
}
