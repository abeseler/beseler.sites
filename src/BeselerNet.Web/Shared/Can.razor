@inject AccountSession Session

@* Visibility only — missing permission hides the children. Gate pages with RequirePermission so a direct URL gets a denied state. *@
@if (IsAllowed)
{
    @ChildContent
}

@code {
    [Parameter] public string Resource { get; set; } = "";
    [Parameter] public string Action { get; set; } = "";
    [Parameter] public string? Scope { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsAllowed =>
        !string.IsNullOrWhiteSpace(Resource)
        && !string.IsNullOrWhiteSpace(Action)
        && Session.HasPermission(Resource, Action, Scope);
}
