@inject AccountSession Session
@inject NavigationManager Nav

@if (ready)
{
    <IdleWatch />
    @ChildContent
}
else
{
    <div class="auth-shell">
        <p class="auth-lede">Loading…</p>
    </div>
}

@code {
    [Parameter] public bool RequireVerified { get; set; } = true;
    [Parameter] public bool RedirectIfVerified { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private bool ready;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();

        var here = CurrentPath();

        if (!Session.HasSession)
        {
            Redirect(ReturnUrl.WithReturn(Routes.Login, here));
            return;
        }

        if (RequireVerified && !Session.EmailVerified)
        {
            Redirect(ReturnUrl.WithReturn(Routes.VerifyEmail, here));
            return;
        }

        if (RedirectIfVerified && Session.EmailVerified)
        {
            Redirect(ReturnUrl.Sanitize(ReturnFromQuery()) ?? Routes.Dashboard);
            return;
        }

        ready = true;
    }

    private void Redirect(string url)
    {
        if (!RendererInfo.IsInteractive && HttpContext is not null)
        {
            HttpContext.Response.Redirect(url);
            return;
        }

        Nav.NavigateTo(url, replace: true);
    }

    private string? CurrentPath()
    {
        if (HttpContext is not null)
            return HttpContext.Request.Path + HttpContext.Request.QueryString;

        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        return relative.StartsWith('/') ? relative : "/" + relative;
    }

    private string? ReturnFromQuery()
    {
        if (HttpContext?.Request.Query.TryGetValue(ReturnUrl.Query, out var value) is true)
            return value.ToString();

        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query)
            .TryGetValue(ReturnUrl.Query, out var fromNav))
        {
            return fromNav.ToString();
        }

        return null;
    }
}
